{
  "name": "sexchat-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run generate && tsc && node -e \"require('node:fs').cpSync('src/generated/prisma','dist/generated/prisma',{recursive:true})\"",
    "start": "node dist/server.js",
    "postinstall": "npm run generate",
    "db:push": "prisma db push --schema=../../prisma/schema.prisma",
    "generate": "prisma generate --schema=../../prisma/schema.prisma && node scripts/fix-prisma-module.cjs"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2",
    "livekit-server-sdk": "^2.15.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.3",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
